# ============================================================================
# UNIHUB — Variables de entorno
# ============================================================================
# Copia este archivo como ".env" y completa tus credenciales de Supabase.
# Si dejas este archivo sin completar (o no creas ".env"), UniHub funciona
# automáticamente en MODO DEMO con datos locales de Universidad EAN — no
# se requieren credenciales para explorar el MVP.
#
# Encuentra estos valores en: Supabase Dashboard > Project Settings > API
# NUNCA subas tu archivo ".env" real a un repositorio público.
# ============================================================================

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica
